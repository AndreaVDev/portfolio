---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHOW_BLOG } from '../../lib/config';
import { sanityClient } from '../../lib/sanity';
import { blogPostsQuery } from '../../lib/queries';
import type { BlogPost } from '../../types';

if (!SHOW_BLOG) {
  return Astro.redirect('/');
}

const posts = await sanityClient.fetch<BlogPost[]>(blogPostsQuery);
---

<BaseLayout title="Blog">
  <section class="pt-12 pb-8">
    <h1 class="font-sans text-2xl font-semibold text-portfolio-text-main">Blog</h1>
  </section>

  <div class="border-t border-portfolio-border">
    {
      posts.map((post) => (
        <a
          href={`/blog/${post.slug.current}`}
          class="group flex items-start justify-between py-6 border-b border-portfolio-border hover:bg-portfolio-surface transition-colors duration-200 -mx-4 px-4 sm:-mx-8 sm:px-8"
        >
          <div class="flex-1 pr-8 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-sans text-base font-medium text-portfolio-text-main group-hover:text-portfolio-accent transition-colors duration-200">
                {post.title}
              </span>
              <span
                class="inline-block opacity-0 translate-x-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-200 text-portfolio-accent"
                aria-hidden="true"
              >
                ↗
              </span>
            </div>
            {post.excerpt && (
              <p class="font-sans text-sm text-portfolio-text-muted mt-1 line-clamp-2">
                {post.excerpt}
              </p>
            )}
          </div>
          <span class="font-mono text-xs text-portfolio-text-muted shrink-0 pt-1">
            {new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
            })}
          </span>
        </a>
      ))
    }
    {posts.length === 0 && (
      <p class="font-mono text-sm text-portfolio-text-muted py-8">No posts yet.</p>
    )}
  </div>
</BaseLayout>
